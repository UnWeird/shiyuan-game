# Dependencies
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json

# Build outputs
dist/
dist-ssr/
build/
**/dist/
**/build/
server/lib/

# shared/ 只放 .ts 源码。编译产物归 server/lib/shared/。
# 曾经有过期的 shared/*.js 被提交进来，客户端直接 import shared/ 时
# Rollup 会优先解析那份 CommonJS 产物，导致「XXX is not exported」构建失败。
shared/**/*.js
shared/**/*.d.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Local development
*.local
